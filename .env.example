# Copy to .env.local and fill in real values. .env.local is gitignored.
# Supabase project settings -> Data API / API Keys.

# --- Public: inlined into the client bundle by Next. Public by design. ------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Secret: server-only. Never prefix these with NEXT_PUBLIC_. -------------
# Bypasses Row Level Security. Only imported via src/lib/env.server.ts, which
# is guarded by `server-only`.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute base URL, used for the link on shared result cards. Optional —
# defaults to http://localhost:3000. Public by design.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local preview of packs that are not yet is_live. Server-only: never exposed
# to the browser, and must stay unset in production.
# PREVIEW_UNLISTED_PACKS=1
